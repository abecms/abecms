    "fs-compare": "0.0.4",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "handlebars-helper-slugify": "^0.3.2",
    "handlebars-helpers": "^0.10.0",
    "handlebars-layouts": "^3.1.4",
    "helmet": "^8.0.0",
    "inquirer": "^8.2.6",
    "jwt-simple": "^0.5.6",
    "lodash": "^4.18.1",
    "marked": "^15.0.6",
    "mkdirp": "^1.0.4",
    "moment": "^2.30.1",
    "mongodb": "^6.12.0",
    "nanoajax": "^0.4.3",
    "node-sqlparser": "^1.0.4",
    "nodemailer": "^9.0.3",
    "nodemailer-mailgun-transport": "^2.1.5",
    "nodemailer-mandrill-transport": "^1.2.0",
    "on": "^1.3.0",
    "openurl": "^1.1.1",
    "owasp-password-strength-test": "^1.3.0",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "passport-http-bearer": "^1.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2-client-password": "^0.1.2",
    "prettyjson": "^1.2.5",
    "qs": "^6.14.1",
    "ratelimiter": "^3.4.1",
    "redis": "^4.7.0",
    "sharp": "^0.32.6",
    "slugify": "^1.6.6",
    "smartcrop-sharp": "^2.0.8",
    "smtp-server": "^3.18.5",
    "socket.io": "^4.8.1",
    "striptags": "^3.2.0",
    "surge": "^0.27.4",
    "tiny-lr": "^2.0.0",
    "which": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/node": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/register": "^7.25.9",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "chai": "^4.5.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.2",
    "core-js": "^3.39.0",
