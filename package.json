{
  "name": "abecms",
  "version": "5.12.0",
  "description": "Abe: The lightning fast CMS",
  "main": "src/server/app.js",
  "bugs": "https://github.com/abecms/abecms/issues",
  "repository": {
    "type": "git",
    "url": "git://github.com/abecms/abecms.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "opencv": "github:peterbraden/node-opencv",
    "lint": "eslint --fix --quiet src/",
    "test": "mocha --recursive --require @babel/register --require ./tests/babel-setup.js --exit tests/unit",
    "test:demo": "mocha --recursive --require @babel/register --require ./tests/babel-setup.js --exit tests/gateway",
    "start:demo": "node dist/demo/index.js",
    "dev:demo": "node -r @babel/register src/demo/index.js",
    "test-cov": "nyc _mocha -- --recursive --require @babel/register --require ./tests/babel-setup.js --exit tests/unit",
    "test-coveralls": "nyc _mocha -- --recursive --require @babel/register --require ./tests/babel-setup.js --exit tests/unit && nyc report --reporter=text-lcov",
    "test-e2e": "playwright test",
    "pretest-e2e": "npm run distribute",
    "postinstall": "npm run build:front",
    "preversion": "npm run distribute",
    "postversion": "git push origin master --follow-tags && npm publish",
    "watch": "concurrently \"node ./src/tasks/esbuild-front.js --watch\" \"npm run watch:sass\"",
    "watch:sass": "chokidar 'src/server/sass/**/*' -c 'npm run sass' --initial",
    "build:front": "node ./src/tasks/esbuild-front.js && npm run sass",
    "sass": "node ./src/tasks/sass.js",
    "mvasset": "mkdirp dist/server/public/abecms && cp -r src/server/locale dist/server && cp -r src/server/views dist/server && cp -r src/server/public/abecms/css dist/server/public/abecms && cp -r src/server/public/abecms/libs dist/server/public/abecms && cp -r src/server/public/abecms/vendors dist/server/public/abecms && cp -r src/server/public/abecms/fonts dist/server/public/abecms && cp -r src/server/public/abecms/image dist/server/public/abecms && cp -r src/server/public/abecms/scripts dist/server/public/abecms && cp -r src/cli/core/config/config.json dist/cli/core/config/config.json",
    "compile": "./node_modules/.bin/babel -d dist/ src/",
    "distribute": "npm run build:front && npm run compile && npm run mvasset",
    "dev": "npm run build:front && concurrently -k \"node src/tasks/nodemon.js\" \"npm run watch\""
  },
  "author": "gregorybesson<bessong@gmail.com>",
  "license": "MIT",
  "contributors": [
    {
      "name": "gregorybesson",
      "email": "bessong@gmail.com",
      "url": "https://github.com/gregorybesson"
    },
    {
      "name": "Fabrice Labbe",
      "url": "https://github.com/wonknu"
    },
    {
      "name": "Nicolas Labbe",
      "url": "https://github.com/nicolaslabbe"
    },
    {
      "name": "Olivier Pompilius",
      "url": "https://github.com/opompilius"
    }
  ],
  "preferGlobal": true,
  "bin": {
    "abe": "dist/index.js"
  },
  "overrides": {
    "axios": "^1.16.1",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@5": "5.0.7",
    "nodemailer": "^9.0.3",
    "braces": "^3.0.3",
    "cookie": "^0.7.2",
    "cross-spawn": "^7.0.6",
    "diff": "^8.0.3",
    "elliptic": "^6.6.1",
