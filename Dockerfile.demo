# ABECMS demo renderer — public gateway image.
#
# Only the demo gateway is started. The ABECMS back office is never mounted.
# The image is self contained: no host volume, no outbound network needed at
# runtime.
#
# The container fails to start unless ABE_DEMO_API_TOKEN is supplied at run time
# (or the development-only ABE_DEMO_ALLOW_UNAUTHENTICATED=true opt-out is set).
# No token is ever baked into the image.

# ---------------------------------------------------------------------------
# Stage 1 — build the ABECMS distribution (src/ -> dist/)
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS build

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
# postinstall runs the front-end build, which needs the sources.
COPY src ./src
COPY .babelrc ./

RUN npm ci --no-audit --no-fund

COPY demo ./demo

RUN npm run distribute \
    && npm prune --omit=dev \
    && rm -rf src /root/.npm /root/.cache

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    ABE_DEMO_HOST=0.0.0.0 \
    ABE_DEMO_PORT=8080 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

COPY --from=build --chown=node:node /build/node_modules ./node_modules
COPY --from=build --chown=node:node /build/dist ./dist
COPY --from=build --chown=node:node /build/demo ./demo
COPY --from=build --chown=node:node /build/package.json ./package.json

USER node

EXPOSE 8080

# The ABECMS module tree is large, so allow a generous start period.
# /health is intentionally unauthenticated so the probe needs no credential.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.ABE_DEMO_PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/demo/index.js"]
