    "highlight.js": "^11.11.1",
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0",
    "lodash": "^4.18.1",
    "merge": "^2.1.1",
    "micromatch": "^4.0.8",
    "minimist": "^1.2.8",
    "nth-check": "^2.1.1",
    "qs": "^6.14.1",
    "semver": "^7.7.2",
    "serialize-javascript": "^7.0.5",
    "shell-quote": "^1.8.4",
    "tar": "^7.5.16",
    "tmp": "^0.2.6",
    "tough-cookie": "^4.1.4",
    "uuid": "^11.1.1",
    "websocket-driver": "0.7.5",
    "ws": "^8.21.0",
    "xml2js": "^0.6.2"
  },
